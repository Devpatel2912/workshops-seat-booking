{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "env": {
    "node": true,
    "es2022": true
  },

  "categories": {
    "correctness": "warn"
  },

  "rules": {
    "eslint/no-unused-vars": "error",
    "eslint/no-undef": "error",
    "eslint/no-console": "off"
  },

  "ignorePatterns": ["node_modules/**", "dist/**", "coverage/**"]
}
